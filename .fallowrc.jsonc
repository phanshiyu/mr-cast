{
  "$schema": "./node_modules/fallow/schema.json",
  // Every way code is started: the CLI and the children it forks, the player, the bundles esbuild builds from a
  // path (validate's fit report and the engine's syntax colours), scripts, example generators, tests and evaluations.
  "entry": [
    "bin/mr-cast.mjs",
    "bin/lib/voice-child.mjs",
    "bin/lib/update-check.mjs",
    "src/main.tsx",
    "src/fit/report.ts",
    "src/engine/highlight.ts",
    "scripts/*.mjs",
    "examples/**/generate.mjs",
    "examples/explain/bitcoin/mine.mjs",
    "examples/primitives/image/make-pictures.mjs",
    "test/**/*.test.mjs",
    "quality/*.mjs",
    "quality/effort/*.mjs"
  ],
  // Rust's tools, which scripts/build-wasm.mjs and bin/lib/engine.mjs run; rustup and cargo install provide them.
  "ignoreBinaries": ["cargo", "wasm-bindgen"],
  // The engine compiled to WebAssembly: vite.config.ts aliases it to engine/wasm/pkg, which `pnpm build:wasm` writes, so
  // a checkout that has not built it yet has nothing to resolve (its types are in src/engine/mrc-wasm.d.ts).
  "ignoreUnresolvedImports": ["mrc-wasm"],
  "ignorePatterns": ["bin/lib/kokoro/**", "shared/world/**", "dist/**"],
  "ignoreExports": [
    // bin/mr-cast.mjs imports render.mjs on demand and destructures the result, which fallow cannot follow.
    { "file": "bin/lib/render.mjs", "exports": ["renderVideo", "renderStills", "renderSheets", "stopRenders"] },
    // The record of which stacks the metrics were measured for (see engine/README.md).
    { "file": "shared/font-metrics.mjs", "exports": ["FONT_STACKS"] },
    // Tests bundle these modules with esbuild from a path string and call these.
    { "file": "src/utils/arrayLayout.ts", "exports": ["cellBox", "ghostShown"] },
    { "file": "src/utils/chartLayout.ts", "exports": ["between", "delta", "valueLabels"] },
    { "file": "src/utils/penGeometry.ts", "exports": ["sketchMark"] },
    { "file": "src/utils/readingLayout.ts", "exports": ["moreText"] },
    { "file": "src/utils/graphLayout.ts", "exports": ["layoutGraph"] },
    { "file": "src/utils/tableLayout.ts", "exports": ["layoutTable"] },
    { "file": "src/utils/textLayout.ts", "exports": ["textRects", "countText"] },
    { "file": "src/utils/timelineLayout.ts", "exports": ["packRow"] }
  ],
  "rules": {
    // An unused dev tool fails like an unused runtime dependency.
    "unused-dev-dependencies": "error",
    // Each scene's layout module has its own ROW_H, PAD_X and Placed* types, with its own values and fields.
    "duplicate-exports": "off"
  }
}

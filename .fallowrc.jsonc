{
  "$schema": "./node_modules/fallow/schema.json",
  // Every way code is started: the CLI and the children it forks, the player, the bundles esbuild builds from a
  // path (the render composition and validate's fit report), scripts, example generators, tests and evaluations.
  "entry": [
    "bin/mr-cast.mjs",
    "bin/lib/voice-child.mjs",
    "bin/lib/update-check.mjs",
    "src/main.tsx",
    "src/remotion/index.ts",
    "src/fit/report.ts",
    "scripts/*.mjs",
    "examples/**/generate.mjs",
    "examples/explain/bitcoin/mine.mjs",
    "examples/primitives/image/make-pictures.mjs",
    "test/**/*.test.mjs",
    "quality/*.mjs",
    "quality/effort/*.mjs"
  ],
  "ignorePatterns": ["bin/lib/kokoro/**", "shared/world/**", "dist/**"],
  "ignoreExports": [
    // bin/mr-cast.mjs imports render.mjs on demand and destructures the result, which fallow cannot follow.
    { "file": "bin/lib/render.mjs", "exports": ["renderVideo", "renderStills", "closeBrowsers"] },
    // Generated by scripts/measure-fonts.mjs as the record of what it measured.
    { "file": "shared/font-metrics.mjs", "exports": ["FONT_STACKS"] },
    // Tests bundle these modules with esbuild from a path string and call these.
    { "file": "src/utils/chartLayout.ts", "exports": ["between"] },
    { "file": "src/utils/graphLayout.ts", "exports": ["layoutGraph"] },
    { "file": "src/utils/tableLayout.ts", "exports": ["layoutTable"] },
    { "file": "src/utils/textLayout.ts", "exports": ["textRects"] },
    { "file": "src/utils/timelineLayout.ts", "exports": ["packRow"] }
  ],
  "rules": {
    // An unused dev tool fails like an unused runtime dependency.
    "unused-dev-dependencies": "error",
    // Each scene's layout module has its own ROW_H, PAD_X and Placed* types, with its own values and fields.
    "duplicate-exports": "off"
  }
}

{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!bin/lib/kokoro",
      "!shared/world",
      "!shared/font-metrics.mjs",
      "!examples/**/*.json",
      "!.claude/skills/verify/fixtures",
      "!quality/keys",
      "!quality/fixtures"
    ]
  },
  "assist": { "enabled": false },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    // bin/lib/schema.mjs reads src/types.ts line by line and prints its declarations to the agent as written,
    // one line per type alias.
    "includes": ["**", "!src/types.ts"]
  },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}

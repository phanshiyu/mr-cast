    {
      "type": "intent",
      "narration": "A long sequence scrolls under its participants.",
      "summary": "One order, then a refused one, in twenty messages.",
      "risk": "low",
      "bullets": [
        "The camera keeps the current messages in view",
        "The participants stay pinned at the top"
      ]
    },
    {
      "type": "sequence",

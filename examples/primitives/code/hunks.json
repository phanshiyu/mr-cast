    "afterCode": "/** Runs `fn` once the calls stop for `waitMs`, with the last args. */\nexport function debounce<A extends unknown[]>(\n  fn: (...args: A) => void,\n  waitMs = 250,\n) {\n  let timer: ReturnType<typeof setTimeout> | undefined;\n  const call = (...args: A) => {\n    if (timer !== undefined) clearTimeout(timer);\n    timer = setTimeout(() => {\n      timer = undefined;\n      fn(...args);\n    }, waitMs);\n  };\n  /** Drops a waiting call, e.g. when the search box goes away. */\n  call.cancel = () => {\n    clearTimeout(timer);\n    timer = undefined;\n  };\n  return call;\n}",

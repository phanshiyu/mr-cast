    "deletions": 5,
    "beforeCode": "import { deliver } from '../src/webhooks/deliver';\n\ntest('posts the event as JSON', async () => {\n  const seen = mockServer([200]);\n  await deliver(seen.url, { id: 1 });\n  expect(seen.bodies).toEqual(['{\"id\":1}']);\n});\n\ntest('throws when the receiver errors', async () => {\n  await expect(deliver(mockServer([500]).url, {})).rejects.toThrow('webhook failed: 500');\n});\n\ntest('returns delivered on 200', async () => {\n  expect(await deliver(mockServer([200]).url, {})).toBe('delivered');\n});",
    "afterCode": "import { deliver } from '../src/webhooks/deliver';\n\nconst noWait = async () => {};\n\ntest('posts the event as JSON', async () => {\n  const seen = mockServer([200]);\n  await deliver(seen.url, { id: 1 }, noWait);\n  expect(seen.bodies).toEqual(['{\"id\":1}']);\n});\n\ntest('returns delivered on 200', async () => {\n  expect(await deliver(mockServer([200]).url, {}, noWait)).toBe('delivered');\n});\n\ntest('retries a 503 until it succeeds', async () => {\n  const seen = mockServer([503, 503, 200]);\n  expect(await deliver(seen.url, {}, noWait)).toBe('delivered');\n  expect(seen.calls).toBe(3);\n});\n\ntest('gives up after three retries', async () => {\n  const seen = mockServer([500, 500, 500, 500, 500]);\n  expect(await deliver(seen.url, {}, noWait)).toBe('failed');\n  expect(seen.calls).toBe(4);\n});\n\ntest('does not retry a 400', async () => {\n  const seen = mockServer([400, 200]);\n  expect(await deliver(seen.url, {}, noWait)).toBe('failed');\n  expect(seen.calls).toBe(1);\n});\n\ntest('waits 1, 4 and 16 seconds', async () => {\n  const waits: number[] = [];\n  await deliver(mockServer([500, 500, 500, 500]).url, {}, async (ms) => void waits.push(ms));\n  expect(waits).toEqual([1000, 4000, 16000]);\n});",

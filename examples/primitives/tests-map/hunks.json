    "beforeCode": "export async function deliver(url: string, event: object) {\n  const res = await fetch(url, { method: 'POST', body: JSON.stringify(event) });\n  if (!res.ok) throw new Error(`webhook failed: ${res.status}`);\n  return 'delivered';\n}",
    "afterCode": "const WAITS_MS = [1_000, 4_000, 16_000];\n\nexport async function deliver(url: string, event: object, sleep = wait) {\n  for (let attempt = 0; ; attempt++) {\n    const res = await fetch(url, { method: 'POST', body: JSON.stringify(event) });\n    if (res.ok) return 'delivered';\n    if (res.status < 500 || attempt === WAITS_MS.length) return 'failed';\n    await sleep(WAITS_MS[attempt]);\n  }\n}\n\nconst wait = (ms: number) => new Promise((done) => setTimeout(done, ms));",

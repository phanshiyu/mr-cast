    "beforeCode": "import { redis } from '../redis';\nimport { SESSION_MAX_AGE_DAYS } from '../config';\n\nexport async function load(id: string) {\n  const raw = await redis.get(`session:${id}`);\n  return raw ? JSON.parse(raw) : null;\n}\n\nexport async function save(id: string, data: object) {\n  await redis.set(`session:${id}`, JSON.stringify(data), 'EX', SESSION_MAX_AGE_DAYS * 86400);\n}",
    "afterCode": "import { redis } from '../redis';\nimport { SESSION_IDLE_MINUTES, SESSION_MAX_AGE_DAYS } from '../config';\n\nconst IDLE_S = SESSION_IDLE_MINUTES * 60;\n\nexport async function load(id: string) {\n  const raw = await redis.get(`session:${id}`);\n  if (!raw) return null;\n  const session = JSON.parse(raw);\n  if (Date.now() - session.createdAt > SESSION_MAX_AGE_DAYS * 86_400_000) return null;\n  await redis.expire(`session:${id}`, IDLE_S);\n  return session;\n}\n\nexport async function save(id: string, data: object) {\n  await redis.set(`session:${id}`, JSON.stringify({ ...data, createdAt: Date.now() }), 'EX', IDLE_S);\n}",

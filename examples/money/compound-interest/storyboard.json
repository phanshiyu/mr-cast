      ],
      "labels": {
        "start": "ten thousand dollars",
        "end": "thirty years later"
      },
      "narration": "Say you put ten thousand dollars away today, in something that grows seven percent a year, and you do not touch it.",
      "steps": [
        {
          "show": [
            "end"
          ],
          "focus": [
            "end"
          ],
          "say": "Thirty years later, the statement says $76,123. More than seven times what you put in.",
          "draw": [
            {
              "write": "on paper",
              "near": "end",
              "side": "below",
              "when": "statement"
            }
          ]
        },
        {
          "focus": [
            "start",
            "end"
          ],
          "say": "That sounds great. But prices rise too. So how much of that is real?",
          "draw": [
            {
              "write": "but what will it buy?",
              "near": "end",
              "side": "left",
              "tone": "bad",
              "when": "how much"
            }
          ]
        }
      ]
    },
    {
      "type": "svg",
      "chapter": "Interest on interest",
      "title": "Each year’s interest is bigger",
      "svg": "<svg viewBox=\"0 0 1200 640\">\n<g id=\"y1\"><text x=\"40\" y=\"150\" font-size=\"24\" font-size=\"28\">year 1: 7% of $10,000.00</text>\n<rect x=\"40\" y=\"174\" width=\"595\" height=\"56\" rx=\"6\"/>\n\n<text x=\"651\" y=\"212\" font-size=\"24\" font-size=\"26\">$700.00</text>\n<text x=\"1170\" y=\"212\" font-size=\"24\" text-anchor=\"end\" fill=\"var(--muted)\">ends $10,700.00</text></g>\n<g id=\"y2\"><text x=\"40\" y=\"310\" font-size=\"24\" font-size=\"28\">year 2: 7% of $10,700.00</text>\n<rect x=\"40\" y=\"334\" width=\"595\" height=\"56\" rx=\"6\"/>\n<rect id=\"extra2\" x=\"635\" y=\"334\" width=\"41.7\" height=\"56\" rx=\"6\" class=\"tone-good\"/>\n<text x=\"692.65\" y=\"372\" font-size=\"24\" font-size=\"26\">$749.00</text>\n<text x=\"1170\" y=\"372\" font-size=\"24\" text-anchor=\"end\" fill=\"var(--muted)\">ends $11,449.00</text></g>\n<g id=\"y3\"><text x=\"40\" y=\"470\" font-size=\"24\" font-size=\"28\">year 3: 7% of $11,449.00</text>\n<rect x=\"40\" y=\"494\" width=\"595\" height=\"56\" rx=\"6\"/>\n<rect id=\"extra3\" x=\"635\" y=\"494\" width=\"86.2\" height=\"56\" rx=\"6\" class=\"tone-good\"/>\n<text x=\"737.2154999999999\" y=\"532\" font-size=\"24\" font-size=\"26\">$801.43</text>\n<text x=\"1170\" y=\"532\" font-size=\"24\" text-anchor=\"end\" fill=\"var(--muted)\">ends $12,250.43</text></g>\n<g id=\"base\"><line x1=\"635\" y1=\"80\" x2=\"635\" y2=\"560\" stroke=\"var(--muted)\" stroke-width=\"2\" stroke-dasharray=\"8 8\"/><text x=\"635\" y=\"70\" font-size=\"24\" text-anchor=\"middle\" fill=\"var(--muted)\">$700</text></g>\n</svg>",
      "hidden": [
        "y2",
        "y3"
      ],
      "labels": {
        "y1": "year one",
        "y2": "year two",
        "y3": "year three",
        "extra2": "forty nine dollars",
        "extra3": "bigger"
      },
      "narration": "First, where the growth comes from. Here are the first three years, worked out by hand.",
      "steps": [
        {
          "focus": [
            "y1",
            "base"
          ],
          "say": "In year one, seven percent of ten thousand is $700. You end the year with $10,700."
        },
        {
          "show": [
            "y2"
          ],
          "focus": [
            "extra2"
          ],
          "say": "In year two you earn seven percent of the new total, $749. Forty nine dollars more, because last year's interest is earning too.",
          "draw": [
            {
              "write": "+$49",
              "near": "extra2",
              "side": "above",
              "tone": "good",
              "when": "Forty nine"
            }
          ]
        },
        {
          "show": [
            "y3"
          ],
          "focus": [
            "extra3"
          ],
          "say": "Year three pays $801.43. Each year's interest is bigger than the last.",
          "draw": [
            {
              "write": "interest earns interest",
              "near": "extra3",
              "side": "below",
              "tone": "good",
              "when": "bigger"
            }
          ]
        }
      ]
    },

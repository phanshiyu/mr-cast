      "number": "$10,000",
      "note": "growing 7% a year, untouched",
      "steps": [
        {
          "set": {
            "number": "$76,123",
            "note": "thirty years later, on paper"
          },
          "say": "Thirty years later, the statement says $76,123. More than seven times what you put in."
        },
        {
          "set": {
            "kicker": "But what will it buy?"
          },
          "focus": [
            "kicker"
          ],
          "say": "That sounds great. But prices rise too. So how much of that is real? Let us work it out, one piece at a time."
        }
      ]
    },
    {

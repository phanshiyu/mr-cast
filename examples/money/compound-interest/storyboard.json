      "labels": {
        "formula": "seventy two",
        "bar7": "seven percent",
        "ex7": "exact answer"
      },
      "narration": "There is a shortcut for how fast this grows.",
      "steps": [
        {
          "focus": [
            "formula"
          ],
          "say": "Divide seventy two by the growth rate, and you get roughly how many years it takes to double."
        },
        {
          "focus": [
            "bar7",
            "formula"
          ],
          "say": "At seven percent, seventy two divided by seven is 10.3 years.",
          "draw": [
            {
              "write": "72 ÷ 7 = 10.3",
              "near": "bar7",
              "side": "above",
              "when": "divided by seven"
            }
          ]
        },
        {
          "show": [
            "ex7"
          ],
          "focus": [
            "ex7"
          ],
          "erase": true,
          "say": "The exact answer is 10.24 years. Less than a month apart."

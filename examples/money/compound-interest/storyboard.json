      "chapter": "The rule of 72",
      "title": "Divide 72 by the rate",
      "svg": "<svg viewBox=\"0 0 1200 640\">\n<text id=\"formula\" x=\"1170\" y=\"60\" text-anchor=\"end\" font-size=\"30\">years to double: about 72 / rate</text>\n<line x1=\"80\" y1=\"570\" x2=\"1140\" y2=\"570\" stroke=\"var(--text)\" stroke-width=\"3\"/>\n<g id=\"bar2\"><rect x=\"150\" y=\"138\" width=\"120\" height=\"432\" rx=\"6\"/><text x=\"210\" y=\"172\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\">36</text><text x=\"210\" y=\"610\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\" fill=\"var(--muted)\">2%</text></g>\n<g id=\"bar4\"><rect x=\"350\" y=\"354\" width=\"120\" height=\"216\" rx=\"6\"/><text x=\"410\" y=\"388\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\">18</text><text x=\"410\" y=\"610\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\" fill=\"var(--muted)\">4%</text></g>\n<g id=\"bar7\"><rect x=\"550\" y=\"446.6\" width=\"120\" height=\"123.4\" rx=\"6\"/><text x=\"610\" y=\"480.6\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\">10.3</text><text x=\"610\" y=\"610\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\" fill=\"var(--muted)\">7%</text></g>\n<g id=\"bar10\"><rect x=\"750\" y=\"483.6\" width=\"120\" height=\"86.4\" rx=\"6\"/><text x=\"810\" y=\"517.6\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\">7.2</text><text x=\"810\" y=\"610\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\" fill=\"var(--muted)\">10%</text></g>\n<g id=\"bar12\"><rect x=\"950\" y=\"498\" width=\"120\" height=\"72\" rx=\"6\"/><text x=\"1010\" y=\"532\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\">6</text><text x=\"1010\" y=\"610\" font-size=\"24\" text-anchor=\"middle\" font-size=\"26\" fill=\"var(--muted)\">12%</text></g>\n<g id=\"ex2\"><line x1=\"130\" y1=\"150\" x2=\"290\" y2=\"150\" class=\"stroke-good\" stroke-width=\"5\"/><text x=\"210\" y=\"122\" font-size=\"24\" text-anchor=\"middle\" class=\"tone-good\">exact 35.0</text></g>\n<g id=\"ex4\"><line x1=\"330\" y1=\"357.9\" x2=\"490\" y2=\"357.9\" class=\"stroke-good\" stroke-width=\"5\"/><text x=\"410\" y=\"338\" font-size=\"24\" text-anchor=\"middle\" class=\"tone-good\">exact 17.7</text></g>\n<g id=\"ex7\"><line x1=\"530\" y1=\"447.1\" x2=\"690\" y2=\"447.1\" class=\"stroke-good\" stroke-width=\"5\"/><text x=\"610\" y=\"430.6\" font-size=\"24\" text-anchor=\"middle\" class=\"tone-good\">exact 10.24</text></g>\n<g id=\"ex10\"><line x1=\"730\" y1=\"482.7\" x2=\"890\" y2=\"482.7\" class=\"stroke-good\" stroke-width=\"5\"/><text x=\"810\" y=\"466.7\" font-size=\"24\" text-anchor=\"middle\" class=\"tone-good\">exact 7.3</text></g>\n<g id=\"ex12\"><line x1=\"930\" y1=\"496.6\" x2=\"1090\" y2=\"496.6\" class=\"stroke-good\" stroke-width=\"5\"/><text x=\"1010\" y=\"480.6\" font-size=\"24\" text-anchor=\"middle\" class=\"tone-good\">exact 6.1</text></g>\n</svg>",

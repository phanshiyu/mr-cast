{
  "title": "Rate limiting for the Orders API",
  "subtitle": "feature/rate-limit → main",
  "scenes": [
    {
      "type": "intent",
      "chapter": "Why this change",
      "narration": "This merge request protects the orders endpoint from bursts of traffic and starts emitting an event every time an order is created.",
      "summary": "Add Redis-backed rate limiting to POST /orders and publish order.created events.",
      "risk": "medium",
      "bullets": [
        "Fixed-window limiter: 20 requests per minute per IP",
        "Prices now come from the pricing service instead of a constant",
        "New order.created event on the queue",
        "Removes the unused in-memory throttle"
      ]
    },
    {
      "type": "arch",
      "chapter": "Where it fits",
      "narration": "Requests now pass through a rate limiter backed by Redis before reaching the orders service, which writes to the database and then publishes to the event queue.",

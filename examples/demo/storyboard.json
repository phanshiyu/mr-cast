    {
      "type": "flow",
      "chapter": "A request, step by step",
      "title": "POST /orders",
      "narration": "Follow one request. The limiter counts it, the service prices the items and saves the order, and the API publishes a compact event before responding.",
      "steps": [
        {
          "actor": "Client",
          "action": "Sends the order",
          "payload": "{ \"userId\": \"u_42\", \"items\": [{ \"sku\": \"tea\", \"qty\": 2 }] }"
        },
        {
          "actor": "rateLimit",
          "action": "Counts the request in Redis",
          "payload": "rl:10.0.0.7:29384112 → 3"
        },
        {
          "actor": "createOrder",
          "action": "Prices items and inserts",
          "payload": "{ \"id\": \"o_9f\", \"total\": 8.4, \"status\": \"pending\" }"
        },
        {
          "actor": "publish",
          "action": "Emits order.created",
          "payload": "{ \"orderId\": \"o_9f\", \"total\": 8.4 }"
        },
        {
          "actor": "API",
          "action": "Responds 201 Created"
        }
      ]
    }

  "scenes": [
    {
      "type": "svg",
      "chapter": "The puzzle",
      "title": "Smooth waves, and a shape that jumps",
      "picture": "waves",
      "narration": "Here is a strange claim. Add enough perfectly smooth waves, and you get a shape with a sharp jump in it.",
      "hidden": [
        "sin1",
        "sinA",
        "next3",
        "wave",
        "n2",
        "n3",
        "n5",
        "n13",
        "n50",
        "mid",
        "edge",
        "peak13",
        "peak50",
        "question",
        "square"
      ],
      "labels": {
        "sin1": "sine wave",
        "square": "square wave",
        "question": "how could this ever work"
      },
      "steps": [
        {
          "trace": [
            {
              "ref": "sin1",
              "when": "bends"
            }
          ],
          "focus": "sin1",
          "say": "A sine wave bends gently, everywhere. It never has a corner."
        },
        {
          "trace": [
            {
              "ref": "square",
              "when": "sits flat"
            }
          ],
          "focus": "square",
          "say": "A square wave sits flat, then jumps straight down, then jumps back up."
        },
        {
          "show": [
            "question"
          ],
          "focus": "question",
          "say": "Adding smooth things should give something smooth. So how could this ever work? Let us try it and see."
        }
      ]
    },
    {
      "type": "svg",
      "chapter": "One wave",
      "title": "The best single wave is still wrong",
      "picture": "waves",
      "narration": "The dashed line is our target, the square wave. It is one for half the time, then minus one.",
      "hidden": [
        "sinA",
        "next3",
        "wave",
        "n2",
        "n3",
        "n5",
        "n13",
        "n50",
        "mid",
        "edge",
        "peak13",
        "peak50",
        "question"
      ],
      "labels": {
        "sin1": "sin x",
        "sinA": "stretch",
        "mid": "middle",
        "edge": "near the jump"
      },
      "steps": [
        {
          "focus": [
            "sin1",
            "square"
          ],
          "say": "Start with the plainest wave there is, sin x. It goes up when the square wave is up, and down when it is down."
        },
        {
          "hide": [
            "sin1"
          ],
          "trace": [
            {
              "ref": "sinA",
              "when": "stretch"
            }
          ],
          "focus": "sinA",
          "say": "Now stretch it until it matches the target as well as one wave can. That is a height of four over pi.",
          "draw": [
            {
              "write": "best height: 4 ÷ π = 1.27",
              "near": "sinA",
              "side": "right",
              "when": "four over pi"
            }
          ]
        },
        {
          "show": [
            "mid"
          ],
          "erase": true,
          "focus": [
            "mid"
          ],
          "tint": {
            "mid": "bad"
          },
          "say": "It is not a good match yet. In the middle it climbs to 1.27, too high.",
          "draw": [
            {
              "write": "too high",
              "near": "mid",
              "side": "right",
              "when": "too high",
              "tone": "bad"
            }
          ]
        },
        {
          "show": [
            "edge"
          ],
          "focus": [
            "edge"
          ],
          "say": "And near the jump it is far too low, only 0.50.",

%% mr-cast architecture contract (designed).
%% Solid arrow = dependency the design allows. Dotted arrow = planned. -->|test| = test code only.
%% 22 nodes for about 100k lines in three languages and three runtimes (Node CLI, browser page, Rust engine): about 7 nodes
%% per stack, each a stated responsibility; the engine core is five nodes cut by the concerns ADR 42 names, not by file.
%% Read left to right: entry points first, foundations last.
%% The stacks meet in four places only:
%%  - shared/ and src/types.ts: the Node CLI and the page both import them (shared imports only types, type-only).
%%  - A process boundary: bin/lib/engine.mjs writes props JSON and spawns the mr-cast-engine binary. Not an import, so no edge.
%%  - The vite alias `mrc-wasm`, the wasm-pack build of engine/wasm (src/player/CanvasPlayer.tsx:5), the only way the page reaches the engine.
%%  - esbuild bundling: bin/lib/validate-fit.mjs:17 bundles src/fit/report.ts and bin/lib/engine.mjs:98 bundles src/engine/highlight.ts. Not imports, so no edges.
flowchart LR
  subgraph dev["Tooling and tests"]
    tooling["tooling: repo scripts, vite config, index.html, the agent verify skill, the evaluation harness and the example generators"]
    tests["tests: the node test suites and the Rust fixture tests against the JS"]
  end

  subgraph node-entry["Node CLI: entry"]
    cli["cli: argv parsing and command orchestration"]
  end

  subgraph node-features["Node CLI: features"]
    cli-validate["cli-validate: the storyboard checks and their suggestions"]
    cli-engine["cli-engine: drives the Rust engine, its stills, and the voice-over with its settings"]
    cli-serve["cli-serve: the local server for play and plan"]
  end

  subgraph node-workspace["Node CLI: workspace"]
    cli-workspace["cli-workspace: the CLI's on-disk state and content: runs, processes, pruning, updates, skill install, snippets, change maps, images and plans"]
  end

  subgraph node-base["Node CLI: helpers"]
    cli-base["cli-base: UserError, JSON, git, diff parsing, cache and lock"]
  end

  subgraph web["Web page"]
    web-app["web-app: the page shell, the panels and the canvas player with its timeline"]
    web-engine["web-engine: syntax colours handed to the engine"]
  end

  subgraph ts-layout["TS layout (validate's fit check, bundled by the CLI)"]
    layout["layout: the TS scene layouts validate runs (the fit report is mapped to fit until it moves)"]
    fit["fit: the places text goes: slots, shell box, callout and source fit"]
  end

  subgraph foundation["Shared foundation"]
    shared["shared: storyboard semantics both runtimes run: timing, steps, targets, textfit, normalize"]
    types["types: the storyboard schema and the palette and frame tokens"]
  end

  subgraph engine-bin["Engine: binaries"]
    engine-cli["engine-cli: mr-cast-engine commands (render, still, sheet, probe, voice) and the MP4 encoder"]
    engine-wasm["engine-wasm: the browser player's renderer, core behind wasm-bindgen"]
    dizione["dizione: English text to tiny-voca phoneme tokens"]
  end

  subgraph core-top["Engine core: composition"]
    core-api["core-api: Project, build_frame and render_frame, and the rasterizer"]
    core-scenes["core-scenes: one module per scene type behind one registry, with the chrome every scene shares"]
  end

  subgraph core-mid["Engine core: refs, steps and the pen"]
    core-steps["core-steps: what a step's focus names, how steps change a scene, pen marks, ink and the camera"]
  end

  subgraph core-found["Engine core: drawing and foundations"]
    core-draw["core-draw: display list, icons, diagram paths, board look, fonts, text fitting, colours, easing, the palette, and step light and motion"]
    core-script["core-script: the props model, timing, markup, speech, focus and chapters"]
  end

  %% Allowed-edge reasons that are not obvious:
  %% web-app --> engine-wasm: CanvasPlayer.tsx:5 imports `mrc-wasm`, a vite alias (vite.config.ts:50) to engine/wasm/pkg/mrc_wasm.js, the
  %%   git-ignored wasm-pack output (`pnpm build:wasm`). driftwall counts an alias into engine/wasm/ as a dependency on engine-wasm even
  %%   before the build exists, so any other node importing `mrc-wasm` is a violation.
  %% web-app owns src/utils/timing.ts and captions.ts: the playback timeline and caption pages App and the player use; they import no layout.
  %% web-engine owns src/utils/highlight.ts: the Prism highlighter whose colours the engine draws code in (src/engine/highlight.ts:1-3).
  %% layout --> fit: every layout fits text against the slots of src/fit/slots.ts and the shell box (CONTRIBUTING.md:57).
  %% tooling --> web-app, shared: index.html loads src/main.tsx; the evaluation harness and example generators import shared.
  %% cli --> every cli-* node and shared: bin/mr-cast.mjs parses argv and orchestrates every command (CONTRIBUTING.md:54).
  %% cli-serve --> cli-workspace, cli-engine: the server reads plan and image files and names the voice clips (AUDIO_NAME of voice.mjs).
  %% cli-engine --> cli-workspace: voice-child.mjs registers itself in the process registry (procs.mjs), ADR 27.
  %% cli-workspace --> types: images.mjs:270 names ImageManifest, type-only.
  %% shared --> types: the .d.mts files type the storyboard with src/types.ts, type-only.
  %% engine-cli --> core-script, core-draw: main.rs reads Props and timing (FPS, settled_frame); sheet.rs draws its own labels with the core's
  %%   text, display list and theme. The rest goes through core-api.
  %% engine-cli --> dizione: voice.rs speaks clips with tiny-voca, whose phonemizer is dizione.
  %% core-api --> core-scenes, core-draw, core-script: lib.rs builds each scene and its chrome, sets the board look, and times the project.
  %% core-scenes --> core-steps: a scene is built from refs, states, the pen and the camera (engine/README.md:199-250); nothing below imports scenes.
  %% core-steps: refs (targets, arrays), state walks (states), pen marks and ink (marks) and the camera are one subsystem in engine/README.md:199-250.
  %%   marks::Pen holds a Board and a Camera, so marks <-> camera is a cycle inside this node on purpose; lint cannot see it (see "Not expressible yet").
  %% tests -->|test| ...: test/ imports whatever it exercises; engine/core/tests check timing, speech, text fitting, springs, easings and pen
  %%   geometry against the JS's own output (tests/js_fixtures.rs, tests/marks_geometry.rs); engine/dizione/tests check the phonemizer.
  %%
  %% Forbidden directions (lint reports them; none is declared):
  %% - Foundations import nothing above them: types imports nothing, shared imports only types, core-script imports nothing, core-draw only core-script.
  %% - The Node CLI never imports src/ but types; the page never imports bin/. src/ never imports engine/ (the page reaches it through mrc-wasm).
  %% - web-app never imports layout or fit, and web-engine never imports layout or fit: the page draws with the engine (CONTRIBUTING.md:55).
  %%   web-engine --> layout is debt today (below).
  %% - cli-base imports no other cli-* node. cli-validate imports only shared: a check stays pure. cli-workspace imports only cli-base, shared, types.
  %% - cli-engine never imports cli-serve or cli-validate. cli-workspace never imports the engine, the server or the checks.
  %% - Engine core, high to low: core-api, core-scenes, core-steps, core-draw, core-script. A lower node never imports a higher one.
  %% - core-draw never imports core-steps, core-scenes or core-api. Nothing in the core imports engine-cli, engine-wasm or dizione.
  %% - engine-wasm imports only core-api. dizione imports no other node.
  %% - core-api's exports (below) list what the binaries import from lib.rs. It is not a facade: lib.rs makes every module pub and engine-cli
  %%   also imports core-script and core-draw.
  %% - Production code never imports tests. tooling is never imported by production code but index.html -> src/main.tsx.
  %%
  %% Debt lint reports today (each is undeclared on purpose; each fix is checked to leave lint clean):
  %% - core-steps --> core-scenes (4 imports): states.rs:589 and targets/mod.rs:19-21. Together with scenes importing targets 38 times and states
  %%   23 times this is the cycle through chrome, states, targets and arrays. targets/mod.rs:3-4 calls the upward dispatch deliberate ("for types
  %%   that resolve through their own typed layout, in the scene's module"): docs and design disagree. Fix: only scenes calls targets::resolve*
  %%   (SceneRefs, with_fallback), so give each scene's REGISTRY entry its resolver (text, table, chart) or move `resolve` into scenes; and the
  %%   svg scene hands the transform check to its StateModel like move_key and morph (states.rs:577-598) instead of states.rs calling parse_transform.
  %% - fit --> layout (25 imports, src/fit/report.ts:6-53): report.ts runs every scene layout and sits under fit, which every layout imports for its
  %%   slots (37 imports): a runtime cycle fit <-> utils. Fix: move report.ts to src/utils/; update ENTRY (bin/lib/validate-fit.mjs:17),
  %%   .fallowrc.jsonc:10 and the docs that name it.
  %% - cli-workspace --> cli-validate (summary.mjs:10): the run summary prints mixLine from validate-mix.mjs, so a pure formatter reaches into a check.
  %%   Fix: move mixLine and runsOf to shared/brief.mjs beside briefLine, which summary.mjs already imports, and let validate-mix import them from there.
  %% - web-engine --> layout (1 import, src/engine/highlight.ts:7, from utils/flowLayout.ts): formatPayload (flowLayout.ts:28-34, a six-line JSON
  %%   pretty-printer) drags flowLayout, fit/slots, textfit and codeLayout into the browser player. Fix: move formatPayload to shared/ or src/engine/.
  %%
  %% Not expressible yet (lint cannot check these, review them by hand):
  %% - marks <-> camera inside core-steps: marks/mod.rs:1045-1111 (Pen) imports camera.rs, which imports marks (camera.rs:6-7). Accepted as one
  %%   subsystem (engine/README.md:199-250). If it is ever split, put Pen in a module above both, as README:226 calls it marks::Pen.
  %% - Bundled, not imported: bin/lib/validate-fit.mjs:17 bundles src/fit/report.ts with esbuild (cli-validate -> layout and fit), bin/lib/engine.mjs:98
  %%   bundles src/engine/highlight.ts (cli-engine -> web-engine), and scripts/engine-dump.mjs bundles src/fit, src/engine and shared from an esbuild
  %%   stdin template. The Node CLI and the page therefore share src/ code lint cannot see; test/ reaches src/utils only by bundling it too.
  %% - shared -> types and cli-workspace -> types are type-only (JSDoc and .d.mts): a value import from types would pass.
  %% - core-script, core-draw and the crate have no threads, files or processes, so they build for wasm32 (engine/README.md, lib.rs:3-4). Not an
  %%   import rule: std::fs or std::thread in them would pass.
  %% - The Node CLI runs the engine as a child process and the engine reads the props JSON: that format (bin/lib/engine.mjs against model.rs) is a
  %%   contract between two languages, not an import.
  %% - core-draw keeps global state that Project::new sets (look::set_board, lib.rs:52): a dependency by side effect.
  %% - core-scenes is one registry with a module per scene type (engine/README.md:111); sibling scene modules import each other (graph -> table and
  %%   text, map -> svg and media, files -> tests), and chrome sits inside it. Lint sees one node, so those are unchecked.
  %% - dizione is one crate that ports a Python package module by module; its modules are acyclic but lint sees one node.


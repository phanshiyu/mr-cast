{
  "name": "@shiyuphan/mr-cast",
  "version": "0.10.0",
  "description": "Turn a git branch / merge request diff into an animated Remotion walkthrough.",
  "keywords": [
    "git",
    "diff",
    "code-review",
    "video",
    "remotion",
    "claude-code",
    "merge-request"
  ],
  "license": "MIT",
  "author": "phanshiyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanshiyu/mr-cast.git"
  },
  "homepage": "https://github.com/phanshiyu/mr-cast#readme",
  "type": "module",
  "bin": {
    "mr-cast": "bin/mr-cast"
  },
  "files": [
    "bin/",
    "src/",
    "shared/",
    "dist/",
    "skill/",
    "examples/demo/*.json",
    "examples/demo-simple/*.json",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "demo": "bash scripts/demo.sh",
    "install-skill": "node bin/mr-cast.mjs install-skill",
    "prepack": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "kokoro-js": "1.2.1",
    "lucide-react": "^1.57.0",
    "mermaid": "11.17.2",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "@shiyuphan/mr-cast",
  "version": "0.19.0",
  "description": "Turn a git branch / merge request diff into an animated Remotion walkthrough.",
  "keywords": [
    "git",
    "diff",
    "code-review",
    "video",
    "remotion",
    "claude-code",
    "merge-request"
  ],
  "license": "MIT",
  "author": "phanshiyu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phanshiyu/mr-cast.git"
  },
  "homepage": "https://github.com/phanshiyu/mr-cast#readme",
  "type": "module",
  "bin": {
    "mr-cast": "bin/mr-cast"
  },
  "files": [
    "bin/",
    "src/",
    "shared/",
    "dist/",
    "skill/",
    "examples/demo/*.json",
    "examples/demo-simple/*.json",
    "examples/people/*.json",
    "examples/review/*.json",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && node scripts/check-text.mjs",
    "demo": "bash scripts/demo.sh",
    "install-skill": "node bin/mr-cast.mjs install-skill",
    "test": "node --test \"test/*.test.mjs\"",
    "prepack": "pnpm run typecheck && pnpm run build",
    "validate:examples": "node scripts/validate-examples.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "dompurify": "^3.4.17",
    "esbuild": "0.28.2",
    "lucide-react": "^1.57.0",
    "mermaid": "12.2.0",
    "phonemizer": "1.2.1",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.11.2"
}

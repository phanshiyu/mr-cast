{
  "name": "mr-cast",
  "version": "0.1.0",
  "description": "Turn a git branch / merge request diff into an animated Remotion walkthrough.",
  "type": "module",
  "private": true,
  "bin": {
    "mr-cast": "bin/mr-cast"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "demo": "bash scripts/demo.sh",
    "install-skill": "node scripts/install-skill.mjs"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.535",
    "@remotion/player": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "lucide-react": "^1.57.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4"
  }
}

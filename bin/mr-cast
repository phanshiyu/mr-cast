#!/usr/bin/env bash
# Finds a real node >= 20 without relying on the caller's shell setup: `node` may be
# missing from PATH or shadowed by a broken shell function (nvm lazy-load shims).
set -eo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link_dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$link_dir/$src"
done
DIR="$(cd -P "$(dirname "$src")" && pwd)"

node_major() {
  [ -n "$1" ] && [ -x "$1" ] && "$1" -p 'process.versions.node.split(".")[0]' 2>/dev/null
}

# Every node binary we can find, most preferred first.
node_candidates() {
  # type -P skips shell functions and aliases, returning only a real binary on PATH.
  type -P node 2>/dev/null || true
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$nvm_dir/nvm.sh" ]; then
    (
      export NVM_DIR="$nvm_dir"
      # shellcheck disable=SC1091
      . "$nvm_dir/nvm.sh" --no-use >/dev/null 2>&1 || true
      nvm which default 2>/dev/null || nvm which node 2>/dev/null || true
    )
    ls -d "$nvm_dir"/versions/node/v*/bin/node 2>/dev/null | sort -rV
  fi
  echo /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node | tr ' ' '\n'
}

# Remotion rendering hangs on Node 26, so prefer the 20-24 LTS lines and only fall back to newer ones.
find_node() {
  local candidate major fallback=""
  while IFS= read -r candidate; do
    major="$(node_major "$candidate")" || continue
    [ -n "$major" ] || continue
    if [ "$major" -ge 20 ] && [ "$major" -le 24 ]; then echo "$candidate"; return; fi
    if [ "$major" -gt 24 ] && [ -z "$fallback" ]; then fallback="$candidate"; fi
  done < <(node_candidates)
  if [ -n "$fallback" ]; then
    echo "mr-cast: no Node 20-24 found, using $("$fallback" -v); rendering may hang on this version" >&2
    echo "$fallback"
  fi
}

NODE="$(find_node)"
if [ -z "$NODE" ]; then
  echo "mr-cast: no node >= 20 found (checked PATH, nvm in ${NVM_DIR:-$HOME/.nvm}, /opt/homebrew/bin, /usr/local/bin). Install Node 20+." >&2
  exit 1
fi

# Child processes (vite, remotion) look up `node` on PATH.
export PATH="$(dirname "$NODE"):$PATH"
exec "$NODE" "$DIR/mr-cast.mjs" "$@"

#!/usr/bin/env bash
# Finds a real Node >= 22.12 without relying on the caller's shell setup: `node` may be
# missing from PATH or shadowed by a broken shell function (nvm lazy-load shims).
set -eo pipefail

src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  link_dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ "$src" != /* ]] && src="$link_dir/$src"
done
DIR="$(cd -P "$(dirname "$src")" && pwd)"

# Node 22.12 is the oldest that Mermaid 12 and the rest of mr-cast's dependencies support.
node_ok() {
  [ -n "$1" ] && [ -x "$1" ] &&
    "$1" -e 'const [a, b] = process.versions.node.split(".").map(Number); process.exit(a > 22 || (a === 22 && b >= 12) ? 0 : 1)' >/dev/null 2>&1
}

# Every node binary we can find, most preferred first.
node_candidates() {
  # type -P skips shell functions and aliases, returning only a real binary on PATH.
  type -P node 2>/dev/null || true
  local nvm_dir="${NVM_DIR:-$HOME/.nvm}"
  if [ -s "$nvm_dir/nvm.sh" ]; then
    (
      export NVM_DIR="$nvm_dir"
      # shellcheck disable=SC1091
      . "$nvm_dir/nvm.sh" --no-use >/dev/null 2>&1 || true
      nvm which default 2>/dev/null || nvm which node 2>/dev/null || true
    )
    ls -d "$nvm_dir"/versions/node/v*/bin/node 2>/dev/null | sort -rV
  fi
  echo /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node | tr ' ' '\n'
}

find_node() {
  local candidate
  while IFS= read -r candidate; do
    if node_ok "$candidate"; then echo "$candidate"; return; fi
  done < <(node_candidates)
}

NODE="$(find_node)"
if [ -z "$NODE" ]; then
  echo "mr-cast: no Node 22.12 or newer found (checked PATH, nvm in ${NVM_DIR:-$HOME/.nvm}, /opt/homebrew/bin, /usr/local/bin). Install Node 24 LTS." >&2
  exit 1
fi

# Child processes (vite, remotion) look up `node` on PATH.
export PATH="$(dirname "$NODE"):$PATH"
exec "$NODE" "$DIR/mr-cast.mjs" "$@"
